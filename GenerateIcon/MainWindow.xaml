<Window x:Class="GenerateIcon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Icon Preview" Height="500" Width="700"
        Background="#2D2D2D">
    <Window.Resources>
        <!-- ============================================================
             EDIT THESE to change the icon.
             The paths use a 24x24 viewBox (Material Design Icons scale).
             ============================================================ -->

        <!-- Colors -->
        <Color x:Key="OutlineColor">#3A3A3A</Color>
        <Color x:Key="HashColor">#2563EB</Color>

        <!-- File shape (outer boundary, closed) -->
        <Geometry x:Key="FileShape">
            M14,2 H6 C4.9,2 4,2.9 4,4 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V8 L14,2 Z
        </Geometry>

        <!-- Fold cover (white area that masks the corner) -->
        <Geometry x:Key="FoldCover">
            M13,2 L13,9.5 C13,9.78 13.22,10 13.5,10 L20,10 L14,2 Z
        </Geometry>

        <!-- Fold line (the bent corner line) -->
        <Geometry x:Key="FoldLine">
            M13,2 V8.5 C13,9.33 13.67,10 14.5,10 H20
        </Geometry>

        <!-- Hash (#) symbol -->
        <Geometry x:Key="HashSymbol">
            M16,14 V13 H14.5 L15,11 H14 L13.5,13 H11.5 L12,11 H11 L10.5,13 H9 V14 H10.25
            L9.75,16 H8 V17 H9.5 L9,19 H10 L10.5,17 H12.5 L12,19 H13 L13.5,17 H15 V16 H13.75
            L14.25,14 H16
            M12.75,16 H10.75 L11.25,14 H13.25 L12.75,16 Z
        </Geometry>

        <!-- Stroke settings -->
        <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
        <SolidColorBrush x:Key="HashBrush" Color="{StaticResource HashColor}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview area with multiple sizes -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Grid.Row="0">

            <!-- 256px preview -->
            <Border Background="Transparent" Margin="12">
                <StackPanel>
                    <Viewbox Width="256" Height="256">
                        <Canvas Width="24" Height="24" x:Name="IconCanvas">
                            <Path Data="{StaticResource FileShape}" Fill="White"
                                  Stroke="{StaticResource OutlineBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="{StaticResource FoldCover}" Fill="White"/>
                            <Path Data="{StaticResource FoldLine}"
                                  Stroke="{StaticResource OutlineBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="{StaticResource HashSymbol}" Fill="{StaticResource HashBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="256" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Smaller previews -->
            <StackPanel VerticalAlignment="Center" Margin="12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,16,0">
                        <Viewbox Width="48" Height="48" RenderOptions.EdgeMode="Aliased">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource FileShape}" Fill="White"
                                      Stroke="{StaticResource OutlineBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="{StaticResource FoldCover}" Fill="White"/>
                                <Path Data="{StaticResource FoldLine}"
                                      Stroke="{StaticResource OutlineBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="{StaticResource HashSymbol}" Fill="{StaticResource HashBrush}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="48" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <Viewbox Width="32" Height="32" RenderOptions.EdgeMode="Aliased">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource FileShape}" Fill="White"
                                      Stroke="{StaticResource OutlineBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="{StaticResource FoldCover}" Fill="White"/>
                                <Path Data="{StaticResource FoldLine}"
                                      Stroke="{StaticResource OutlineBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="{StaticResource HashSymbol}" Fill="{StaticResource HashBrush}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="32" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <Viewbox Width="24" Height="24" RenderOptions.EdgeMode="Aliased">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource FileShape}" Fill="White"
                                      Stroke="{StaticResource OutlineBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="{StaticResource FoldCover}" Fill="White"/>
                                <Path Data="{StaticResource FoldLine}"
                                      Stroke="{StaticResource OutlineBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="{StaticResource HashSymbol}" Fill="{StaticResource HashBrush}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="24" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Viewbox Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource FileShape}" Fill="White"
                                      Stroke="{StaticResource OutlineBrush}" StrokeThickness="2.0"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="{StaticResource FoldCover}" Fill="White"/>
                                <Path Data="{StaticResource FoldLine}"
                                      Stroke="{StaticResource OutlineBrush}" StrokeThickness="2.0"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="{StaticResource HashSymbol}" Fill="{StaticResource HashBrush}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="16" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Export button -->
        <Button Grid.Row="1" Content="Export app.ico" Padding="20,8"
                HorizontalAlignment="Center" Margin="0,0,0,16"
                Click="Export_Click"/>
    </Grid>
</Window>
