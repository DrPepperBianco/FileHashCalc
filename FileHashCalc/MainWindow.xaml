<Window x:Class="FileHashCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="File Hash Calculator" Height="550" Width="900"
        Icon="app.ico"
        MinHeight="400" MinWidth="600"
        Background="{DynamicResource WindowBackground}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="File Hash Calculator" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="  —  Dateien hierher ziehen oder Dateien auswählen"
                           VerticalAlignment="Center" Foreground="{DynamicResource SubtleForeground}" FontSize="12"/>
            </StackPanel>
            <Button x:Name="BtnThemeCycle" Grid.Column="2"
                    Click="BtnThemeCycle_Click" ToolTip="Theme wechseln"
                    Padding="4" MinWidth="32" MinHeight="32"
                   >
                <Viewbox Width="20" Height="20">
                    <Path x:Name="ThemeIcon" Fill="{DynamicResource TextForeground}" Data=""/>
                </Viewbox>
            </Button>
        </Grid>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Algorithmus:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="AlgorithmCombo" Grid.Column="1" Width="120"
                      VerticalAlignment="Center" Margin="0,0,12,0"
/>

            <Button x:Name="BtnSelectFiles" Grid.Column="3" Content="Dateien auswählen..."
                    Click="BtnSelectFiles_Click" Margin="0,0,6,0"/>
            <Button x:Name="BtnClearHistory" Grid.Column="4" Content="Verlauf löschen"
                    Click="BtnClearHistory_Click"/>
        </Grid>

        <!-- Results DataGrid -->
        <DataGrid x:Name="ResultsGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserReorderColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="{DynamicResource GridBackground}"
                  RowBackground="{DynamicResource GridBackground}"
                  AlternatingRowBackground="{DynamicResource GridRowAlt}"
                  BorderBrush="{DynamicResource GridBorder}" BorderThickness="1"
                  Foreground="{DynamicResource GridCellForeground}"
                  LoadingRow="ResultsGrid_LoadingRow">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GridHeaderForeground}"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Hash kopieren" Click="CopyHash_Click"/>
                    <MenuItem Header="Zeile kopieren" Click="CopyRow_Click"/>
                    <MenuItem Header="Eintrag entfernen" Click="RemoveEntry_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dateiname" Binding="{Binding FileName}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GridCellForeground}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="{DynamicResource GridCellForeground}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Algorithmus" Binding="{Binding Algorithm}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GridCellForeground}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GridCellForeground}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBar" Height="18" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Text="Bereit" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubtleForeground}" FontSize="11"/>
            <Button Grid.Column="1" Click="BtnSettings_Click"
                    ToolTip="Einstellungen" Padding="4" MinWidth="32" MinHeight="24"
                    Style="{StaticResource SmallButton}">
                <Viewbox Width="16" Height="16">
                    <Path Fill="{DynamicResource TextForeground}"
                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                </Viewbox>
            </Button>
        </Grid>
    </Grid>
</Window>
