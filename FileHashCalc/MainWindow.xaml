<Window x:Class="FileHashCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="File Hash Calculator" Height="550" Width="900"
        MinHeight="400" MinWidth="600"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0075B5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="File Hash Calculator" Style="{StaticResource HeaderText}"
                       FontSize="18" VerticalAlignment="Center"/>
            <TextBlock Text="  —  Dateien hierher ziehen oder Dateien auswählen"
                       VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Algorithmus:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="AlgorithmCombo" Grid.Column="1" Width="120"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>

            <Button x:Name="BtnSelectFiles" Grid.Column="3" Content="Dateien auswählen..."
                    Padding="12,4" Click="BtnSelectFiles_Click" Margin="0,0,6,0"/>
            <Button x:Name="BtnClearHistory" Grid.Column="4" Content="Verlauf löschen"
                    Padding="12,4" Click="BtnClearHistory_Click"/>
        </Grid>

        <!-- Results DataGrid -->
        <DataGrid x:Name="ResultsGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserReorderColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F9FC"
                  HeadersVisibility="Column"
                  BorderBrush="#CCC" BorderThickness="1">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Hash kopieren" Click="CopyHash_Click"/>
                    <MenuItem Header="Zeile kopieren" Click="CopyRow_Click"/>
                    <MenuItem Header="Eintrag entfernen" Click="RemoveEntry_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dateiname" Binding="{Binding FileName}" Width="200"/>
                <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Algorithmus" Binding="{Binding Algorithm}" Width="80"/>
                <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBar" Height="18" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Text="Bereit" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="11"/>
            <Button x:Name="BtnRegisterSendTo" Grid.Column="1"
                    Content="Zu 'Senden an' hinzufügen" Padding="8,2"
                    Click="BtnRegisterSendTo_Click" FontSize="11" Margin="0,0,6,0"/>
            <Button x:Name="BtnRegisterContext" Grid.Column="2"
                    Content="Im Kontextmenü registrieren" Padding="8,2"
                    Click="BtnRegisterContext_Click" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
